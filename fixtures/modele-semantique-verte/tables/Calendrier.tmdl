table Calendrier
	dataCategory: Time
	lineageTag: 0d2f1c00-0000-4000-8000-000000000010

	column date_sk
		dataType: int64
		isKey
		summarizeBy: none

	column date
		dataType: dateTime
		formatString: dd/mm/yyyy

	column annee
		dataType: int64
		summarizeBy: none

	column trimestre
		dataType: int64
		summarizeBy: none

	column mois
		dataType: int64
		summarizeBy: none

	partition Calendrier = m
		mode: import
		source = "gold.dim_date"
